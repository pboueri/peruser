{
  "name": "peruser",
  "version": "0.1.0",
  "private": true,
  "description": "Chrome extension that lets you re-skin any web page for yourself while keeping it working.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": { "node": ">=22" },
  "workspaces": ["bridge"],
  "scripts": {
    "test": "c8 node --test \"test/**/*.test.js\"",
    "test:unit": "node --test \"test/**/*.test.js\"",
    "test:e2e": "playwright test",
    "check": "npm run test && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "c8": "^10.1.3",
    "jsdom": "^26.0.0"
  }
}
