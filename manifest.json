{
  "manifest_version": 3,
  "name": "Peruser",
  "version": "0.1.0",
  "description": "Describe how you want a page to look or behave; Peruser turns it into a remembered, reversible patch that keeps the page working.",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "sidePanel",
    "activeTab",
    "alarms",
    "scripting",
    "userScripts",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Peruser",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "side_panel": {
    "default_path": "src/sidepanel/sidepanel.html"
  },
  "options_page": "src/options/options.html",
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*",
        "file:///*"
      ],
      "js": [
        "src/content/loader.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/content/runtime.js",
        "src/lib/*.js"
      ],
      "matches": [
        "http://*/*",
        "https://*/*",
        "file:///*"
      ]
    }
  ],
  "commands": {
    "toggle-patches": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Toggle Peruser patches on the current tab"
    },
    "cycle-view": {
      "suggested_key": {
        "default": "Alt+Shift+V"
      },
      "description": "Cycle Peruser views on this site"
    }
  }
}
